{
  "name": "@bippy/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/bippy/tests/e2e",
    "packages/bippy/tests/fixtures/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter bippy dev",
    "build": "bun run --filter bippy build",
    "test": "bun run --filter bippy test",
    "test:all": "bun run --filter bippy test:all",
    "test:e2e": "bun run --filter @bippy/e2e test",
    "publint": "bun run --filter bippy publint",
    "typecheck": "bun run --filter bippy typecheck",
    "sherif": "sherif --fix -p './packages/bippy/tests/fixtures/*'",
    "changeset": "bun run build && changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/cli": "^2.30.0",
    "react-dom-experimental": "npm:react-dom@0.0.0-experimental-1d34f91d-20260909",
    "react-experimental": "npm:react@0.0.0-experimental-1d34f91d-20260909",
    "sherif": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.4"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.4-canary.1",
  "patchedDependencies": {
    "react-devtools-core@8.0.0": "patches/react-devtools-core@8.0.0.patch"
  }
}
