+export interface ReactBuildTypeMap {
+  Development: 1;
+  Production: 0;
+}
+
+export interface ReactSymbolsMap {
+  CONCURRENT_MODE_NUMBER: number;
+  CONCURRENT_MODE_SYMBOL_DESCRIPTION: string;
+  CONCURRENT_MODE_SYMBOL_STRING: string;
+  DEPRECATED_ASYNC_MODE_SYMBOL_DESCRIPTION: string;
+  DEPRECATED_ASYNC_MODE_SYMBOL_STRING: string;
+  ELEMENT_SYMBOL_STRING: string;
+  LEGACY_ELEMENT_SYMBOL_STRING: string;
+}
+
+export interface ReactTypeOfSideEffectMap {
+  ChildDeletion: number;
+  Cloned: number;
+  ContentReset: number;
+  Hydrating: number;
+  PerformedWork: number;
+  Placement: number;
+  Snapshot: number;
+  Update: number;
+  Visibility: number;
+}
+
+export interface ReactWorkTagMap {
+  [name: string]: number;
+}
+
+export interface ReactWorkTagVersionRange {
+  isMinimumExcluded?: boolean;
+  minimumVersion?: string;
+  version: string;
+}
+
+export interface InternalReactConstants {
+  ReactTypeOfWork: ReactWorkTagMap;
+}
+
+export interface ReactDevToolsCore {
+  ReactBuildType: ReactBuildTypeMap;
+  ReactSymbols: ReactSymbolsMap;
+  ReactTypeOfSideEffect: ReactTypeOfSideEffectMap;
+  ReactWorkTagVersionRanges: ReactWorkTagVersionRange[];
+  getInternalReactConstants: (reactVersion: string) => InternalReactConstants;
+}
+
+export declare const ReactBuildType: ReactBuildTypeMap;
+export declare const ReactSymbols: ReactSymbolsMap;
+export declare const ReactTypeOfSideEffect: ReactTypeOfSideEffectMap;
+export declare const ReactWorkTagVersionRanges: ReactWorkTagVersionRange[];
+export declare const getInternalReactConstants: (
+  reactVersion: string,
+) => InternalReactConstants;
+
+export declare const connectToDevTools: (...arguments_: unknown[]) => unknown;
+export declare const connectWithCustomMessagingProtocol: (...arguments_: unknown[]) => unknown;
+export declare const initialize: (...arguments_: unknown[]) => unknown;
+
+declare const ReactDevToolsCore: ReactDevToolsCore;
+export default ReactDevToolsCore;
