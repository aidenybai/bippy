      "id": "sentry",
      "repository": "https://github.com/getsentry/sentry",
      "revision": "a7b4a8a2a78a666418e527d812e81528147789da",
      "description": "Sentry frontend login page (React 19 SPA on react-router data routers, rspack dev server in UI-only mode proxying the API to sentry.io)",
