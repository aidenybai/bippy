{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "jsx": "react",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "paths": {
      "bippy": ["../bippy/src/index.ts"],
      "bippy/install-hook-only": ["../bippy/src/install-hook-only.ts"],
      "bippy/source": ["../bippy/src/source/index.ts"]
    }
  },
  "include": ["tests", "scripts", "vite.config.ts"]
}
