@@ -64,7 +64,86 @@ export interface JobQueue extends Markable {
   get length(): number;
 }
 
+export interface JobQueueCheckpoint {
+  readonly scope: 'selected-job-queue-membership-v1';
+  readonly jobCount: number;
+  restore: () => void;
+  release: () => void;
+}
+
+interface JobQueueState {
+  collections: Set<Job>[];
+  jobs: Job[][];
+}
+
+const queueCheckpoints = new WeakMap<JobQueue, JobQueueState[]>();
+
+const markJob = (job: Job, marker: GCMarker): void => {
+  marker(job.capturedValues);
+  marker(job.job);
+  marker(job.callerRealm);
+  marker(job.callerScriptOrModule);
+};
+
+const markSavedJobs = (queue: JobQueue, marker: GCMarker): void => {
+  for (const state of queueCheckpoints.get(queue) ?? []) {
+    for (const jobs of state.jobs) {
+      for (const job of jobs) markJob(job, marker);
+    }
+  }
+};
+
+const captureJobQueue = (queue: JobQueue, collections: Set<Job>[]): JobQueueCheckpoint => {
+  const owner = surroundingAgent;
+  const validate = (): void => {
+    if (!owner || surroundingAgent !== owner) throw new TypeError('Job queue checkpoint belongs to another Agent');
+    if (owner.jobQueue !== queue) throw new TypeError('Job queue checkpoint requires the Agent queue');
+    if (owner.debugger_isPreviewing) throw new TypeError('Job queue checkpoints do not support debugger preview');
+    const prototype = Object.getPrototypeOf(queue);
+    if (prototype !== BasicJobQueue.prototype && prototype !== ByTypeJobQueue.prototype) {
+      throw new TypeError('Job queue checkpoints require a canonical queue');
+    }
+  };
+  validate();
+  const state: JobQueueState = { collections, jobs: collections.map((collection) => {
+    const jobs: Job[] = [];
+    Set.prototype.forEach.call(collection, (job: Job) => jobs.push(job));
+    return jobs;
+  }) };
+  const stack = queueCheckpoints.get(queue) ?? [];
+  stack.push(state);
+  queueCheckpoints.set(queue, stack);
+  let isReleased = false;
+  const assertActive = (): void => {
+    if (isReleased) throw new Error('Job queue checkpoint is released');
+    if (surroundingAgent !== owner) throw new TypeError('Job queue checkpoint belongs to another Agent');
+    if (stack.at(-1) !== state) throw new Error('Job queue checkpoints require last-in-first-out access');
+  };
+  return {
+    scope: 'selected-job-queue-membership-v1',
+    jobCount: state.jobs[0]!.length,
+    restore: () => {
+      assertActive();
+      validate();
+      state.collections.forEach((collection, index) => {
+        Set.prototype.clear.call(collection);
+        for (const job of state.jobs[index]!) Set.prototype.add.call(collection, job);
+      });
+    },
+    release: () => {
+      assertActive();
+      stack.pop();
+      if (!stack.length) queueCheckpoints.delete(queue);
+      state.collections.length = 0;
+      state.jobs.length = 0;
+      isReleased = true;
+    },
+  };
+};
+
 export class BasicJobQueue extends Set<Job> implements JobQueue, Markable {
+  captureQueue = (): JobQueueCheckpoint => captureJobQueue(this, [this]);
+
