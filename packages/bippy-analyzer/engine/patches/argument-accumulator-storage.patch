+export interface ArgumentAccumulatorStorage {
+  readonly scope: 'engine-argument-accumulator-storage-v1';
+  readonly kind: 'arguments' | 'template-substitutions';
+  readonly list: unknown[];
+  readonly references: readonly unknown[];
+  readonly borrowedReferences: readonly object[];
+}
+
+export const getArgumentAccumulatorStorage = (value: unknown): ArgumentAccumulatorStorage | undefined => {
+  if ((typeof value !== 'object' || value === null) && typeof value !== 'function') return undefined;
+  const allocation = getArgumentAccumulatorInfo(value);
+  if (!allocation) return undefined;
+  if (allocation.agent !== surroundingAgent) throw new TypeError('Argument accumulator belongs to another Agent');
+  if (surroundingAgent.debugger_isPreviewing) throw new TypeError('Argument accumulator inspection does not support debugger preview');
+  if (!Array.isArray(value)) throw new TypeError('Invalid argument accumulator');
+  const state = getNativeListState(value, surroundingAgent);
+  return Object.freeze({
+    scope: 'engine-argument-accumulator-storage-v1',
+    kind: allocation.kind,
+    list: value,
+    references: Object.freeze(state.entries.map((entry) => entry.value)),
+    borrowedReferences: Object.freeze([Array.prototype]),
+  });
+};
