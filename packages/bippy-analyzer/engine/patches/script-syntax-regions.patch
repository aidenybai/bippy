@@ -0,0 +1,185 @@
+import { surroundingAgent, type Agent, type ParseNode } from '#self';
+
+export interface ScriptSyntaxLimits {
+  readonly maxRecords?: number;
+  readonly maxEntries?: number;
+}
+
+export interface ScriptSyntaxRegion {
+  readonly scope: 'read-only-parsed-script-syntax-v1';
+  readonly root: ParseNode.Script;
+  readonly recordCount: number;
+  readonly entryCount: number;
+  readonly maxRecords: number;
+  readonly maxEntries: number;
+  readonly sourceOwnerCount: number;
+  readonly borrowedReferences: readonly object[];
+  readonly validate: () => void;
+}
+
+interface SyntaxField {
+  readonly key: PropertyKey;
+  readonly descriptor: PropertyDescriptor;
+}
+
+interface SyntaxRecord {
+  readonly value: object;
+  readonly prototype: object | null;
+  readonly extensible: boolean;
+  readonly fields: readonly SyntaxField[];
+}
+
+interface SyntaxGetter {
+  readonly getter: unknown;
+  readonly sourceOwner?: object;
+}
+
+interface SyntaxRegistration {
+  readonly agent: Agent;
+  readonly region: ScriptSyntaxRegion;
+}
+
+const nodeGetters = new WeakMap<object, SyntaxGetter>();
+const arrowMethods = new WeakMap<object, unknown>();
+const regions = new WeakMap<object, SyntaxRegistration>();
+
+export const registerSyntaxNode = (node: object, sourceOwner?: object) => {
+  nodeGetters.set(node, { getter: Object.getOwnPropertyDescriptor(node, 'sourceText')?.get, sourceOwner });
+};
+
+export const registerSyntaxArrowInfo = (info: object) => {
+  arrowMethods.set(info, Object.getOwnPropertyDescriptor(info, 'merge')?.value);
+};
+
+export const getScriptSyntaxRegion = (value: object): ScriptSyntaxRegion | undefined => {
+  const registered = regions.get(value);
+  if (!registered) return undefined;
+  if (registered.agent !== surroundingAgent) throw new Error('Script syntax belongs to another agent');
+  return registered.region;
+};
+
+export const registerScriptSyntax = (root: ParseNode.Script, limits: ScriptSyntaxLimits): void => {
+  const maxRecords = limits.maxRecords ?? 100000;
+  const maxEntries = limits.maxEntries ?? 1000000;
+  if (!Number.isSafeInteger(maxRecords) || maxRecords < 0 || maxRecords > 1000000) throw new Error('Invalid script syntax maxRecords');
+  if (!Number.isSafeInteger(maxEntries) || maxEntries < 0 || maxEntries > 8000000) throw new Error('Invalid script syntax maxEntries');
+  const agent = surroundingAgent;
+  const records = new Map<object, SyntaxRecord>();
+  const work: (() => void)[] = [];
+  const sourceOwners = new Map<object, PropertyDescriptor>();
+  let entryCount = 0;
+
+  const addRecord = (value: object, prototype: object, visit: (field: SyntaxField) => void) => {
+    if (records.has(value)) return;
+    if (records.size >= maxRecords) throw new Error('Script syntax exceeded maxRecords');
+    if (Object.getPrototypeOf(value) !== prototype) throw new Error('Unsupported script syntax prototype');
+    const fields: SyntaxField[] = [];
+    for (const key of Reflect.ownKeys(value)) {
+      if (++entryCount > maxEntries) throw new Error('Script syntax exceeded maxEntries');
+      if (typeof key !== 'string') throw new Error('Unsupported script syntax key');
+      const descriptor = Object.getOwnPropertyDescriptor(value, key);
+      if (!descriptor) throw new Error('Missing script syntax descriptor');
+      fields.push({ key, descriptor });
+    }
+    records.set(value, { value, prototype, extensible: Object.isExtensible(value), fields });
+    work.push(() => { for (const field of fields) visit(field); });
+  };
+
+  const primitive = (value: unknown) => value === null || (typeof value !== 'object' && typeof value !== 'function' && typeof value !== 'symbol');
+  const data = (field: SyntaxField): unknown => {
+    if (!('value' in field.descriptor)) throw new Error('Unsupported script syntax accessor');
+    return field.descriptor.value;
+  };
+  const callable = (value: unknown) => {
+    if (typeof value !== 'function') throw new Error('Unsupported script syntax function');
+    addRecord(value, Function.prototype, (field) => {
+      if (!primitive(data(field))) throw new Error('Unsupported script syntax function storage');
+    });
+  };
+  const position = (value: unknown) => {
+    if (!value || typeof value !== 'object') throw new Error('Unsupported script syntax position');
+    addRecord(value, Object.prototype, (field) => {
+      if ((field.key !== 'line' && field.key !== 'column') || typeof data(field) !== 'number') throw new Error('Unsupported script syntax position');
+    });
+  };
+  const location = (value: unknown) => {
+    if (!value || typeof value !== 'object') throw new Error('Unsupported script syntax location');
+    addRecord(value, Object.prototype, (field) => {
+      if (field.key === 'start' || field.key === 'end') position(data(field));
+      else if ((field.key !== 'startIndex' && field.key !== 'endIndex') || typeof data(field) !== 'number') throw new Error('Unsupported script syntax location');
+    });
+  };
+  const visit = (value: unknown): void => {
+    if (primitive(value)) return;
+    if (!value || typeof value !== 'object') throw new Error('Unsupported script syntax reference');
+    if (Array.isArray(value)) {
+      addRecord(value, Array.prototype, (field) => {
+        if (field.key === 'location') location(data(field));
+        else if (field.key === 'length' || (typeof field.key === 'string' && /^(0|[1-9][0-9]*)$/.test(field.key))) visit(data(field));
+        else throw new Error('Unsupported script syntax list field');
+      });
+      return;
+    }
+    if (nodeGetters.has(value)) {
+      addRecord(value, Object.prototype, (field) => {
+        if (field.key === 'sourceText') {
+          const registered = nodeGetters.get(value);
+          if (!registered || field.descriptor.get !== registered.getter || field.descriptor.set || 'value' in field.descriptor) throw new Error('Unsupported script source accessor');
+          if (registered.sourceOwner) {
+            const source = Object.getOwnPropertyDescriptor(registered.sourceOwner, 'source');
+            if (!source || !('value' in source) || typeof source.value !== 'string') throw new Error('Unsupported parser source storage');
+            sourceOwners.set(registered.sourceOwner, source);
+          }
+          callable(field.descriptor.get);
+        } else if (field.key === 'location') location(data(field));
+        else visit(data(field));
+      });
+      return;
+    }
+    if (arrowMethods.has(value)) {
+      addRecord(value, Object.prototype, (field) => {
+        const referenced = data(field);
+        if (field.key === 'merge') {
+          if (referenced !== arrowMethods.get(value)) throw new Error('Unsupported script arrow method');
+          callable(referenced);
+        } else if (field.key === 'isAsync' || field.key === 'hasTrailingComma') {
+          if (typeof referenced !== 'boolean') throw new Error('Unsupported script arrow flag');
+        } else if (field.key === 'yieldExpressions' || field.key === 'awaitExpressions' || field.key === 'awaitIdentifiers') visit(referenced);
+        else throw new Error('Unsupported script arrow field');
+      });
+      return;
+    }
+    throw new Error('Unregistered script syntax reference');
+  };
+
+  visit(root);
+  while (work.length) work.pop()!();
+  const region: ScriptSyntaxRegion = Object.freeze({
+    scope: 'read-only-parsed-script-syntax-v1',
+    root,
+    recordCount: records.size,
+    entryCount,
+    maxRecords,
+    maxEntries,
+    sourceOwnerCount: sourceOwners.size,
+    borrowedReferences: Object.freeze([Object.prototype, Array.prototype, Function.prototype, String.prototype]),
+    validate: () => {
+      if (surroundingAgent !== agent) throw new Error('Script syntax belongs to another agent');
+      for (const [owner, expected] of sourceOwners) {
+        const current = Object.getOwnPropertyDescriptor(owner, 'source');
+        if (!current || !('value' in current) || current.value !== expected.value || current.configurable !== expected.configurable || current.enumerable !== expected.enumerable || current.writable !== expected.writable) throw new Error('Read-only parser source changed');
+      }
+      for (const record of records.values()) {
+        const keys = Reflect.ownKeys(record.value);
+        if (Object.getPrototypeOf(record.value) !== record.prototype || Object.isExtensible(record.value) !== record.extensible || keys.length !== record.fields.length) throw new Error('Read-only script syntax changed');
+        for (let index = 0; index < keys.length; index++) {
+          const field = record.fields[index];
+          const current = Object.getOwnPropertyDescriptor(record.value, keys[index]);
+          const expected = field.descriptor;
+          if (keys[index] !== field.key || !current || current.configurable !== expected.configurable || current.enumerable !== expected.enumerable || current.writable !== expected.writable || current.get !== expected.get || current.set !== expected.set || ('value' in current) !== ('value' in expected) || !Object.is(current.value, expected.value)) throw new Error('Read-only script syntax changed');
+        }
+      }
+    },
+  });
+  for (const value of records.keys()) regions.set(value, { agent, region });
+};
