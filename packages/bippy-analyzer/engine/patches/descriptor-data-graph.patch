+export const createDescriptorGraphCheckpoint = (options: DescriptorGraphCheckpointOptions): DescriptorGraphCheckpoint => {
+  const owner = surroundingAgent;
+  const { roots, graph } = getDataGraphPlan(options);
+  if (owner.debugger_isPreviewing) throw new Error('Descriptor checkpoints do not support debugger preview');
+  const objects = new Set<ObjectValue>();
+  const descriptors: Descriptor[] = [];
+  const descriptorInitializers: DescriptorInitializer[] = [];
+  for (const record of new Set(roots)) {
+    if (descriptorFields.length > graph.maxEntries - graph.entries) throw new RangeError('Data graph entry budget exceeded');
+    graph.entries += descriptorFields.length;
+    const isInitializer = record instanceof DescriptorInitializer;
+    const state = getDescriptorState(record, owner, isInitializer);
+    if (isInitializer) descriptorInitializers.push(record);
+    else descriptors.push(record);
+    for (const slot of state.slots) {
+      const value: unknown = slot.descriptor?.value;
+      if (value instanceof ObjectValue) objects.add(value);
+    }
+  }
+  if (surroundingAgent !== owner) throw new Error('Descriptor graph belongs to another agent');
+  const checkpoint = createCheckpoint({ objects: [...objects], descriptors, descriptorInitializers }, true, graph);
+  return {
+    scope: 'descriptor-data-graph-v1', objectCount: checkpoint.objectCount,
+    descriptorCount: checkpoint.descriptorCount, descriptorInitializerCount: checkpoint.descriptorInitializerCount,
+    entryCount: graph.entries, restore: checkpoint.restore, release: checkpoint.release,
+  };
+};
