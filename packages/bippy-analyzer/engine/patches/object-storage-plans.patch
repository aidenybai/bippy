+    add('ArgumentsParameterMapData', data, 'native');
+    add('ArgumentsParameterMapData.environment', data.environment, 'native');
+    add('ArgumentsParameterMapData.realm', data.realm, 'native');
+    add('ArgumentsParameterMapData.pendingMappings', data.pendingMappings, 'native');
+    add('GetOwnProperty', state.argumentsMap.getOwnProperty, 'implementation');
+    add('OwnPropertyKeys', state.argumentsMap.ownPropertyKeys, 'implementation');
+    add('ArgumentsParameterMapData.getOwnProperty', data.getOwnProperty, 'implementation');
+    add('ArgumentsParameterMapData.ownPropertyKeys', data.ownPropertyKeys, 'implementation');
+    state.argumentsMap.pendingMappings.forEach(([key, name], index) => {
