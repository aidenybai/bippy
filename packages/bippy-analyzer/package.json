{
  "name": "bippy-analyzer",
  "version": "0.0.0",
  "private": true,
  "description": "Finds every state a React app can be in from its source, and verifies it against real renders",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-react-compiler.ts",
    "prepare": "pnpm build",
    "analyze": "tsx src/cli/analyze.ts",
    "conformance": "tsx tests/conformance/runner/cli.ts",
    "viewer": "vite --config viewer/vite.config.ts --port 3200",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/code-frame": "^7.26.2",
    "@babel/core": "^7.26.10",
    "@babel/parser": "7.26.3",
    "@babel/traverse": "7.26.4",
    "@babel/types": "7.26.3",
    "bippy": "workspace:*",
    "commander": "^15.0.0",
    "diff": "^8.0.4",
    "invariant": "^2.2.4",
    "magic-string": "^0.30.21",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.0",
    "pretty-format": "^24.9.0",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.1.12",
    "zod-validation-error": "^4.0.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "1.5.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.0.0",
    "@types/babel__code-frame": "^7.27.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.18.2",
    "@types/invariant": "^2.2.37",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "mermaid": "^12.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.3",
    "shadcn": "^4.22.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "zustand": "^5.0.15"
  }
}
