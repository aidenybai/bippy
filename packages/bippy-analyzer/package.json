{
  "name": "bippy-analyzer",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build:engine": "tsx engine/scripts/build.ts",
    "test:engine-build": "tsx engine/scripts/check-build.ts",
    "test:source-test262": "pnpm --silent build:engine && pnpm --silent setup:test262 && test262-harness --host-type=engine262 --host-path=engine/scripts/cli.ts --host-args=--no-inspect --test262-dir=.test262 --threads=2 --error-for-failures=true",
    "test": "pnpm build:engine && vp test",
    "setup:test262": "tsx scripts/setup-test262.ts",
    "test:test262": "pnpm --silent setup:test262 && test262-harness --host-type=engine262 --host-path=engine262 --host-args=--no-inspect --test262-dir=.test262 --error-for-failures=true",
    "typecheck": "pnpm build:engine && tsc --noEmit"
  },
  "dependencies": {
    "@engine262/engine262": "0.0.1-a600354c2954300d62d108bf9ed3459a8e4a289b"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "25.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260404.1",
    "@unicode/unicode-17.0.0": "1.6.16",
    "devtools-protocol": "0.0.1608973",
    "jsbd": "0.0.11",
    "rollup": "4.60.1",
    "test262-harness": "10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=26"
  }
}
