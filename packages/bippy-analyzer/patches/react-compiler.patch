+function exitsEarly(
+  path: NodePath<t.Statement | t.CatchClause>,
+  tryPath: NodePath<t.TryStatement>,
+): boolean {
+  let found = false;
+  const visitJump = (
+    jumpPath: NodePath<t.BreakStatement | t.ContinueStatement>,
+  ): void => {
+    const label = jumpPath.node.label;
+    const target = jumpPath.findParent(parent =>
+      label != null
+        ? parent.isLabeledStatement() && parent.node.label.name === label.name
+        : parent.isLoop() ||
+            (jumpPath.isBreakStatement() && parent.isSwitchStatement()),
+    );
+    if (target == null || !target.isDescendant(tryPath)) {
+      found = true;
+      jumpPath.stop();
+    }
+  };
+  path.traverse({
+    Function(innerPath) {
+      innerPath.skip();
+    },
+    ReturnStatement(innerPath) {
+      found = true;
+      innerPath.stop();
+    },
+    BreakStatement: visitJump,
+    ContinueStatement: visitJump,
+  });
+  return found;
+}
