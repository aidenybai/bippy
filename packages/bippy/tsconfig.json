{
  "compilerOptions": {
    "jsx": "react",
    "module": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
