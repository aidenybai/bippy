{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "bippy": ["./src/index.ts"],
      "bippy/install-hook-only": ["./src/install-hook-only.ts"],
      "bippy/source": ["./src/source/index.ts"]
    }
  },
  "include": [
    "src",
    "scripts",
    "benchmarks",
    "tests/unit",
    "tests/conformance",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
