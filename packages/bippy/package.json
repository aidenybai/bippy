{
  "name": "bippy",
  "version": "0.7.3",
  "description": "hack into react internals",
  "keywords": [
    "bippy",
    "fiber",
    "internals",
    "react",
    "react devtools",
    "react fiber",
    "react instrumentation"
  ],
  "homepage": "https://bippy.dev",
  "bugs": {
    "url": "https://github.com/aidenybai/bippy/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenybai/bippy.git"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./install-hook-only": {
      "import": {
        "types": "./dist/install-hook-only.d.ts",
        "default": "./dist/install-hook-only.js"
      },
      "require": {
        "types": "./dist/install-hook-only.d.cts",
        "default": "./dist/install-hook-only.cjs"
      }
    },
    "./reconciler": {
      "import": {
        "types": "./dist/reconciler.d.ts",
        "default": "./dist/reconciler.js"
      },
      "require": {
        "types": "./dist/reconciler.d.cts",
        "default": "./dist/reconciler.cjs"
      }
    },
    "./source": {
      "import": {
        "types": "./dist/source.d.ts",
        "default": "./dist/source.js"
      },
      "require": {
        "types": "./dist/source.d.cts",
        "default": "./dist/source.cjs"
      }
    },
    "./dist/*": "./dist/*.js",
    "./dist/*.js": "./dist/*.js",
    "./dist/*.cjs": "./dist/*.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_ENV=production vp pack && tsx scripts/check-react-entry.ts",
    "check:react-internals": "tsx scripts/generate-react-internals.ts --check",
    "coverage": "vp test --coverage",
    "dev": "NODE_ENV=development vp pack --watch",
    "generate:react-internals": "tsx scripts/generate-react-internals.ts",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "nr build",
    "publint": "publint",
    "test": "vp test"
  },
  "dependencies": {
    "@types/react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/gui": "^9.20.0",
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@pixi/react": "^8.0.5",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/fiber": "^9.6.1",
    "@react-three/test-renderer": "^9.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-istanbul": "4.1.10",
    "happy-dom": "^20.11.6",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "konva": "^10.3.0",
    "pixi.js": "^8.19.0",
    "publint": "^0.3.0",
    "react": "^19.2.4",
    "react-17": "npm:react@17.0.2",
    "react-18": "npm:react@18.3.1",
    "react-babylonjs": "^4.0.2",
    "react-devtools-core": "7.0.1",
    "react-devtools-inline": "^7.0.1",
    "react-dom": "^19.2.4",
    "react-dom-17": "npm:react-dom@17.0.2",
    "react-dom-18": "npm:react-dom@18.3.1",
    "react-konva": "^19.2.5",
    "react-nil": "^2.0.0",
    "remotion": "^4.0.496",
    "three": "^0.185.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  }
}
