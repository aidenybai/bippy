exports[`fixture analysis > UploadForm keeps its TLA+ module 1`] = `
"---- MODULE UploadForm ----
\\* error: error (state), 3 values
\\* pending_t1: t1 pending (control), 2 values
\\* opaque_Unknown_throws: Unknown(throws) (opaque), 2 values
VARIABLES error, pending_t1, opaque_Unknown_throws

vars == <<error, pending_t1, opaque_Unknown_throws>>

view == CASE error = "other string" -> "div > p"
          [] error /= "other string" -> "div"
          [] OTHER -> "nothing"

Init ==
  /\\ error = "null"
  /\\ pending_t1 = "idle"
  /\\ opaque_Unknown_throws \\in {"false", "true"}

\\* "Upload"
t1 ==
  /\\ pending_t1 = "idle"
  /\\ pending_t1' = "pending"
  /\\ UNCHANGED <<error, opaque_Unknown_throws>>

\\* "Upload" resolves
t1_fulfilled ==
  /\\ pending_t1 = "pending"
  /\\ error' \\in (IF opaque_Unknown_throws = "true" THEN {"other string"} ELSE {error})
  /\\ pending_t1' = "idle"
  /\\ UNCHANGED <<opaque_Unknown_throws>>

\\* "Upload" rejects
t1_rejected ==
  /\\ pending_t1 = "pending"
  /\\ pending_t1' = "idle"
  /\\ UNCHANGED <<error, opaque_Unknown_throws>>

\\* Unknown(throws) changes
change_opaque_Unknown_throws ==
  /\\ opaque_Unknown_throws' \\in {"false", "true"}
  /\\ UNCHANGED <<error, pending_t1>>

Next == t1 \\/ t1_fulfilled \\/ t1_rejected \\/ change_opaque_Unknown_throws

Spec == Init /\\ [][Next]_vars
===="
`;

