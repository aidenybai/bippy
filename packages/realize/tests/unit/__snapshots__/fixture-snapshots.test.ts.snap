stateDiagram-v2
  direction LR
  state "FeatureBadge" as regions {
    %% isEnabled("search"), isEnabled("sync"), isEnabled("share")
    S1: isEnabled("search") || isEnabled("sync") || isEnabled("share") · {"Features on"}
    S2: !(isEnabled("search") || isEnabled("sync") || isEnabled("share")) · {"Features off"}
    [*] --> S1
    [*] --> S2
    --
    %% isEnabled("sync"), isEnabled("offline")
    S3: isEnabled("sync") && isEnabled("offline") · {"Full sync"}
    S4: !(isEnabled("sync") && isEnabled("offline")) · ∅
    [*] --> S3
    [*] --> S4
  }"
`;

