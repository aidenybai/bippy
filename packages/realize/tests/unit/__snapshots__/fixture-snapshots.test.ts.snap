exports[`fixture analysis > Dashboard keeps its TLA+ module 1`] = `
"---- MODULE Dashboard ----
\\* status: status (input), 3 values
\\* user: user (input), 2 values
\\* items_length: items.length (state), 2 values
\\* pending_t1: t1 pending (control), 2 values
VARIABLES status, user, items_length, pending_t1

vars == <<status, user, items_length, pending_t1>>

view == CASE status = "loading" -> "Spinner"
          [] status /= "loading" /\\ user = "null" -> "SignIn"
          [] status /= "loading" /\\ user = "User" /\\ items_length = ">0" -> "main > List"
          [] status /= "loading" /\\ user = "User" /\\ items_length = "0" -> "main > Empty"
          [] OTHER -> "nothing"

Init ==
  /\\ status \\in {"error", "idle", "loading"}
  /\\ user \\in {"null", "User"}
  /\\ items_length = "0"
  /\\ pending_t1 = "idle"

\\* after first render
t1 ==
  /\\ pending_t1 = "idle"
  /\\ pending_t1' = "pending"
  /\\ UNCHANGED <<status, user, items_length>>

\\* after first render resolves
t1_fulfilled ==
  /\\ pending_t1 = "pending"
  /\\ items_length' = ">0"
  /\\ pending_t1' = "idle"
  /\\ UNCHANGED <<status, user>>

\\* after first render rejects
t1_rejected ==
  /\\ pending_t1 = "pending"
  /\\ pending_t1' = "idle"
  /\\ UNCHANGED <<status, user, items_length>>

\\* setCount(count + 1)
t2 ==
  /\\ status /= "loading" /\\ user = "User"
  /\\ UNCHANGED <<status, user, items_length, pending_t1>>

\\* parent changes status
change_status ==
  /\\ status' \\in {"error", "idle", "loading"}
  /\\ UNCHANGED <<user, items_length, pending_t1>>

\\* parent changes user
change_user ==
  /\\ user' \\in {"null", "User"}
  /\\ UNCHANGED <<status, items_length, pending_t1>>

Next == t1 \\/ t1_fulfilled \\/ t1_rejected \\/ t2 \\/ change_status \\/ change_user

Spec == Init /\\ [][Next]_vars
===="
`;

exports[`fixture analysis > Dashboard keeps its state chart and findings 1`] = `
"---
title: Dashboard src/dashboard.tsx:12
---
stateDiagram-v2
  direction LR
  %% 24 states
  %% status = status (input): error | idle | loading
  %% user = user (input): null | User
  %% items_length = items.length (state): 0 | >0
  %% pending_t1 = t1 pending (control): idle | pending
  S1: Spinner
  S2: SignIn
  S3: main #gt; List
  S4: main #gt; Empty
  [*] --> S1
  [*] --> S2
  [*] --> S4
  S1 --> S1: after first render resolves
  S1 --> S2: parent changes status
  S1 --> S3: parent changes status
  S1 --> S4: parent changes status
  S2 --> S2: after first render resolves
  S2 --> S1: parent changes status
  S2 --> S3: parent changes user
  S2 --> S4: parent changes user
  S3 --> S3: after first render resolves, setCount(count + 1)
  S3 --> S1: parent changes status
  S3 --> S2: parent changes user
  S4 --> S3: after first render resolves
  S4 --> S4: setCount(count + 1)
  S4 --> S1: parent changes status
  S4 --> S2: parent changes user
  %% ⚠ When after first render fails, the render stays the same (L21)"
`;

